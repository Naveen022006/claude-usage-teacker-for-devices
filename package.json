{
  "name": "claude-usage-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "claude-usage-daemon": "daemon/dist/claude-usage-daemon.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node daemon/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "build:daemon": "node daemon/build.mjs",
    "daemon": "node daemon/dist/claude-usage-daemon.mjs",
    "mock": "node tools/mock-hub.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
